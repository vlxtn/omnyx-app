{
  "name": "omnyx-app",
  "version": "1.0.11",
  "description": "Omnyx — Your AI Operating System",
  "main": "main.js",
  "author": "Valentin Puc-Dubois",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.omnyx.app",
    "productName": "Omnyx",
    "copyright": "Copyright © 2026 Omnyx",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "publish": {
      "provider": "github",
      "owner": "vlxtn",
      "repo": "omnyx-app",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Omnyx-Setup.exe",
      "extraResources": [
        {
          "from": "companion-setup.exe",
          "to": "companion-setup.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Omnyx"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Omnyx-${arch}.dmg"
    }
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
